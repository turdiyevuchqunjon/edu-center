# Sayt manzili (Meta CAPI event_source_url va metadata uchun)
NEXT_PUBLIC_SITE_URL=https://educenter.uz

# --- Meta (Facebook) Pixel + Conversions API ---
# Pixel ID: Meta Events Manager > Data Sources > Pixel
NEXT_PUBLIC_META_PIXEL_ID=

# Conversions API access token: Events Manager > Settings > Conversions API > Generate access token
META_CAPI_ACCESS_TOKEN=

# Test Events bo'limidan olinadigan kod (test paytida), productionda bo'sh qoldiring
META_CAPI_TEST_EVENT_CODE=

# --- Telegram Bot ---
# @BotFather orqali yaratilgan bot tokeni
TELEGRAM_BOT_TOKEN=

# Standart chat/guruh ID (agar sahifaga xos ID berilmagan bo'lsa shu ishlatiladi)
TELEGRAM_CHAT_ID=

# Ixtiyoriy: har bir fan/sahifa uchun alohida Telegram chat/guruh ID
# (masalan, har bir yo'nalish o'z guruhiga tushishi uchun). Bo'sh qoldirsangiz
# barchasi yuqoridagi TELEGRAM_CHAT_ID ga tushadi.
TELEGRAM_CHAT_ID_INGLIZ=
TELEGRAM_CHAT_ID_BIOLOGIYA_KIMYO=
TELEGRAM_CHAT_ID_MATEMATIKA=
TELEGRAM_CHAT_ID_TARIX_HUQUQ=
TELEGRAM_CHAT_ID_ONA_TILI=
TELEGRAM_CHAT_ID_UMUMIY=
